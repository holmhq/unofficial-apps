    "hours.update": {
      "handler": "opHoursUpdate",
      "auth": "user",
      "risk": "write",
      "summary": "Change your weekly hours, pause a weekday, or add days off",
      "description": "weekly: only the days you send change, each a list of [\"09:00\",\"17:00\"] ranges ([] for a day off). pause / unpause: weekdays (mon…sun) to switch off or on while keeping their hours. days_off_add / days_off_remove: dates as YYYY-MM-DD in your zone.",
      "input": {
        "type": "object",
        "properties": {
          "weekly": {
            "type": "object",
            "properties": {
              "mon": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 5
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "tue": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 5
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "wed": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 5
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "thu": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 5
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "fri": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 5
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "sat": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 5
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "sun": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 5
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "additionalProperties": false
          },
          "pause": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "type": "string",
              "enum": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat",
                "sun"
              ]
            },
            "description": "Weekdays that offer no times for now; their hours are kept."
          },
          "unpause": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "type": "string",
              "enum": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat",
                "sun"
              ]
            },
            "description": "Paused weekdays to open again with their hours."
          },
          "days_off_add": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "string",
              "maxLength": 10
            },
            "description": "Dates nobody can book."
          },
          "days_off_remove": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "string",
              "maxLength": 10
            },
            "description": "Days off to open again."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object"
      },
      "errors": {
        "APP_INVALID_INPUT": {
          "status": 400,
          "public": true
        },
        "APP_UNAUTHORIZED": {
          "status": 401,
          "public": true
        },
        "APP_FORBIDDEN": {
          "status": 403,
          "public": true
        },
        "APP_NOT_FOUND": {
          "status": 404,
          "public": true
        },
        "APP_CONFLICT": {
          "status": 409,
          "public": true
        },
        "APP_GONE": {
          "status": 410,
          "public": true
        },
        "APP_RATE_LIMITED": {
          "status": 429,
          "public": true
        }
      }
