    "events.create": {
      "handler": "opEventsCreate",
      "auth": "user",
      "risk": "write",
      "summary": "Add a kind of meeting",
      "description": "Adds an event type with its own link (/@handle/<slug>). Only title is required; the rest have sensible defaults.",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80,
            "description": "Name people see, like \"Intro call\"."
          },
          "duration": {
            "type": "integer",
            "minimum": 5,
            "maximum": 720,
            "description": "Length in minutes."
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "color": {
            "type": "string",
            "enum": [
              "red",
              "orange",
              "yellow",
              "green",
              "teal",
              "blue",
              "indigo",
              "purple",
              "pink",
              "graphite"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "none",
                  "video",
                  "phone",
                  "place",
                  "custom"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 300,
                "description": "The https:// video link, the address, or the text for custom."
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "notice": {
            "type": "integer",
            "minimum": 0,
            "maximum": 43200,
            "description": "Minutes of notice a booking needs (default 240)."
          },
          "window": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "description": "How many days ahead people can book (default 60)."
          },
          "step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 720,
            "description": "Minutes between start times; 0 picks one from the length."
          },
          "before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240,
            "description": "Free minutes kept before each meeting."
          },
          "after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240,
            "description": "Free minutes kept after each meeting."
          },
          "active": {
            "type": "boolean",
            "description": "Shown on the page (true) or hidden."
          },
          "requests": {
            "type": "boolean",
            "description": "Let guests ask for times outside the open hours."
          },
          "slug": {
            "type": "string",
            "maxLength": 40,
            "description": "The link; made from the title when left out."
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object"
      },
      "errors": {
        "APP_INVALID_INPUT": {
          "status": 400,
          "public": true
        },
        "APP_UNAUTHORIZED": {
          "status": 401,
          "public": true
        },
        "APP_FORBIDDEN": {
          "status": 403,
          "public": true
        },
        "APP_NOT_FOUND": {
          "status": 404,
          "public": true
        },
        "APP_CONFLICT": {
          "status": 409,
          "public": true
        },
        "APP_GONE": {
          "status": 410,
          "public": true
        },
        "APP_RATE_LIMITED": {
          "status": 429,
          "public": true
        }
      }
    },
