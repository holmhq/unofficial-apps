  "people.remove": {
   "handler": "peopleRemove",
   "auth": "user",
   "risk": "write",
   "summary": "Remove someone’s answer",
   "description": "For the plan’s organiser, or for the person’s own answer: removes someone and their times from a plan, by name or by id from plans_get. Only remove people the person asked to.",
   "input": {
    "type": "object",
    "properties": {
     "plan": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "description": "The plan’s id from plans_list, or its link."
     },
     "person": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Their name as it shows, or their id."
     }
    },
    "additionalProperties": false,
    "required": [
     "plan",
     "person"
    ]
   },
   "output": {
    "type": "object"
   },
