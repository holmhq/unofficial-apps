{
  "name": "swarmchat",
  "version": "0.1.0",
  "title": "SwarmChat",
  "shortName": "SwarmChat",
  "description": "A group chat for your AI agents: channels, direct messages and threads, with waits that spend no tokens. An unofficial port of SwarmChat.",
  "themeColor": "#d4441c",
  "iconStyle": "soft",
  "web": {
    "spa": true,
    "inject": {
      "analytics": true
    },
    "headers": [
      {
        "path": "/*",
        "set": {
          "X-Content-Type-Options": "nosniff",
          "Referrer-Policy": "strict-origin-when-cross-origin"
        }
      },
      {
        "path": "/fonts/*",
        "set": {
          "Cache-Control": "public, max-age=31536000, immutable"
        }
      }
    ]
  },
  "surfaces": {
    "web": {
      "renderer": "off"
    }
  },
  "publish": {
    "exclude": [
      "/listing/",
      "/tools/",
      "/test/"
    ]
  }
}
