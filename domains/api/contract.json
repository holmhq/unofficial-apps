  "lists.create": {
   "handler": "listsCreate",
   "auth": "user",
   "risk": "write",
   "summary": "Make a list",
   "idempotency": "optional",
   "description": "Makes a list with a name, an optional note for whoever it’s shared with, and optional names to start with. share: true also gives it a link that opens for anyone, no sign-in, with every name checked live as it opens. Up to 50 lists of 200 names.",
   "input": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "The list’s name, such as \"For Maya\"."
     },
     "note": {
      "type": "string",
      "maxLength": 280,
      "description": "A note for whoever sees the list."
     },
     "names": {
      "type": "array",
      "items": {
       "type": "string",
       "maxLength": 120
      },
      "maxItems": 50,
      "description": "Domains to put on it."
     },
     "share": {
      "type": "boolean",
      "description": "Make a share link now."
     }
    },
    "additionalProperties": false,
    "required": [
     "name"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
     "public": true
    },
    "APP_CONFLICT": {
     "status": 409,
     "public": true
    }
   }
  },
  "lists.update": {
   "handler": "listsUpdate",
   "auth": "user",
   "risk": "write",
   "summary": "Change a list",
   "idempotency": "optional",
   "description": "Renames a list, changes its note, adds or removes names, or turns its share link on or off (off stops the link at once; on again makes a new one). Returns the list with its names and link.",
   "input": {
    "type": "object",
    "properties": {
     "list": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "The list’s id or name from lists_list."
     },
     "name": {
      "type": "string",
      "maxLength": 40,
      "description": "A new name."
     },
     "note": {
      "type": "string",
      "maxLength": 280,
      "description": "A new note; an empty string clears it."
     },
     "add": {
      "type": "array",
      "items": {
       "type": "string",
       "maxLength": 120
      },
      "maxItems": 50,
      "description": "Domains to add."
     },
     "remove": {
      "type": "array",
      "items": {
       "type": "string",
       "maxLength": 120
      },
      "maxItems": 50,
      "description": "Domains to take off."
     },
     "share": {
      "type": "boolean",
      "description": "true for a share link, false to stop sharing."
     }
    },
    "additionalProperties": false,
    "required": [
     "list"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
     "public": true
    },
    "APP_CONFLICT": {
     "status": 409,
     "public": true
    }
   }
  },
  "lists.delete": {
   "handler": "listsDelete",
   "auth": "user",
   "risk": "destructive",
   "summary": "Delete a list",
   "idempotency": "optional",
   "description": "Deletes one of the person’s lists for good, and stops its share link. The names stay saved if they were starred. Only delete a list the person asked you to.",
   "input": {
    "type": "object",
    "properties": {
     "list": {
