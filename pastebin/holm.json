{
  "name": "pastebin",
  "version": "0.4.0",
  "title": "pastebin",
  "description": "Private-first text, code and media pastes with expiring links and burn-after-read sharing.",
  "themeColor": "#173a72",
  "surfaces": {
    "web": {
      "renderer": "off"
    }
  },
  "web": {
    "spa": true,
    "inject": {
      "analytics": true
    }
  },
  "publish": {
    "exclude": [
      "/listing/"
    ]
  },
  "ext": {
    "com.holmhq.unofficial": {
      "demo": "https://pastebin.zyt.app"
    }
  }
}
