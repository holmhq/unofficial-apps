  "pastes.delete": {
   "handler": "pastesDelete",
   "auth": "user",
   "risk": "destructive",
   "summary": "Delete a paste",
   "idempotency": "optional",
   "description": "Deletes one of the person’s pastes for good, with its files, and removes it from their list. Only do this when the person asks; pastes_revoke stops a link but keeps the record.",
   "input": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 12,
      "maxLength": 300,
      "description": "The paste’s id from pastes_list, or its link."
     }
    },
    "additionalProperties": false,
