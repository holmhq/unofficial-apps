  "pastes.open": {
   "handler": "pastesOpen",
   "auth": "user",
   "risk": "write",
   "summary": "Open a shared paste",
   "description": "Reads a paste from a pastebin link someone shared with the person, the way opening it in pastebin would: it counts a view. A one-time paste comes back sealed: opening it shows it once and deletes it for everyone, so ask the person first, then call again with burn true; its whole text comes back at once. Otherwise long pastes come in parts, as in pastes_read.",
   "input": {
    "type": "object",
    "properties": {
     "link": {
      "type": "string",
      "minLength": 12,
      "maxLength": 300,
      "description": "The paste’s link, or its id."
     },
     "burn": {
      "type": "boolean",
      "description": "Open a one-time paste, which deletes it. Only when the person agreed."
     },
     "offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Character to start from (default 0)."
     },
     "length": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 60000,
      "description": "Characters to return (default 30000)."
     }
    },
    "additionalProperties": false,
    "required": [
     "link"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
