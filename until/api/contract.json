{
 "operations": {
  "trackers.list": {
   "handler": "trackersList",
   "auth": "user",
   "risk": "read",
   "summary": "See your trackers",
   "description": "Lists the person’s trackers in their Until account: running ones first, then upcoming, then past. Each has its id, title, start and end dates, length, status, what its card says (days left, days to start, or days since it ended), today’s stars and the average so far. Trackers kept only in a signed-out browser aren’t in the account, so they don’t appear. Read one with its ratings using trackers_get.",
   "input": {
    "type": "object",
    "properties": {
     "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The person’s date today where they are, YYYY-MM-DD. Without it, today in UTC, which can be a day off."
     },
     "status": {
      "type": "string",
      "enum": [
       "running",
       "upcoming",
       "past"
      ],
      "description": "Only trackers in this state."
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "description": "How many to return (default 100)."
     }
    },
    "additionalProperties": false
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
     "public": true
    },
    "APP_CONFLICT": {
     "status": 409,
     "public": true
    }
   }
  },
  "trackers.get": {
   "handler": "trackersGet",
   "auth": "user",
   "risk": "read",
   "summary": "Read a tracker",
   "description": "One of the person’s trackers with every day they’ve rated (1 to 5 stars), oldest first, how many days got each number of stars, and how many days so far have no rating.",
   "input": {
    "type": "object",
    "properties": {
     "tracker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The tracker’s id from trackers_list, or its exact title."
     },
     "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The person’s date today where they are, YYYY-MM-DD. Without it, today in UTC, which can be a day off."
     }
    },
    "additionalProperties": false,
    "required": [
     "tracker"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
     "public": true
    },
    "APP_CONFLICT": {
     "status": 409,
     "public": true
    }
   }
  },
  "trackers.create": {
   "handler": "trackersCreate",
   "auth": "user",
   "risk": "write",
   "summary": "Add a tracker",
   "idempotency": "optional",
   "description": "Adds a tracker to the person’s Until account: a run of days from a start date, counting down to its last day. Give its length as days, or as an end date (its last day). It starts today unless start says otherwise.",
   "input": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "What it counts down to, such as “Trip to Lisbon”."
     },
     "subtitle": {
      "type": "string",
      "maxLength": 120,
      "description": "An optional second line."
     },
     "start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The first day, YYYY-MM-DD. Defaults to today."
     },
     "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 36525,
      "description": "How many days it runs, the start day included."
     },
     "end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The last day, YYYY-MM-DD, instead of days."
     },
     "icon": {
      "type": "string",
      "enum": [
       "CalendarDays",
       "Flag",
       "Gift",
       "Heart",
       "Hourglass",
       "Mountain",
       "Plane",
       "Rocket",
       "Sparkles",
       "Sprout",
       "SunMedium",
       "Waves"
      ],
      "description": "Its icon; one is picked at random without it."
     },
     "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The person’s date today where they are, YYYY-MM-DD. Without it, today in UTC, which can be a day off."
     }
    },
    "additionalProperties": false,
    "required": [
     "title"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
     "public": true
    },
    "APP_CONFLICT": {
     "status": 409,
     "public": true
    }
   }
  },
  "trackers.update": {
   "handler": "trackersUpdate",
   "auth": "user",
   "risk": "write",
   "summary": "Change a tracker",
   "idempotency": "optional",
   "description": "Changes one of the person’s trackers: its title, subtitle, icon or dates. A new start alone keeps the length; days or end set a new length. Ratings for days that fall outside the new dates are dropped, and the answer says how many.",
   "input": {
    "type": "object",
    "properties": {
     "tracker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The tracker’s id from trackers_list, or its exact title."
     },
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "A new title."
     },
     "subtitle": {
      "type": "string",
      "maxLength": 120,
      "description": "A new second line; empty removes it."
     },
     "icon": {
      "type": "string",
      "enum": [
       "CalendarDays",
       "Flag",
       "Gift",
       "Heart",
       "Hourglass",
       "Mountain",
       "Plane",
       "Rocket",
       "Sparkles",
       "Sprout",
       "SunMedium",
       "Waves"
      ],
      "description": "A new icon."
     },
     "start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "A new first day, YYYY-MM-DD."
     },
     "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 36525,
      "description": "A new length in days, the start day included."
     },
     "end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "A new last day, YYYY-MM-DD, instead of days."
     },
     "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The person’s date today where they are, YYYY-MM-DD. Without it, today in UTC, which can be a day off."
     }
    },
    "additionalProperties": false,
    "required": [
     "tracker"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
     "public": true
    },
    "APP_CONFLICT": {
     "status": 409,
     "public": true
    }
   }
  },
  "days.rate": {
   "handler": "daysRate",
   "auth": "user",
   "risk": "write",
   "summary": "Rate a day",
   "idempotency": "optional",
   "description": "Gives one day of a tracker 1 to 5 stars, or 0 to clear it, as the stars do in Until. It rates today unless day says otherwise; a day that hasn’t come yet can’t be rated. Other days’ ratings are kept.",
   "input": {
    "type": "object",
    "properties": {
     "tracker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The tracker’s id from trackers_list, or its exact title."
     },
     "stars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "1 to 5 stars, or 0 to clear the day."
     },
     "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The day to rate, YYYY-MM-DD. Defaults to today."
     },
     "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The person’s date today where they are, YYYY-MM-DD. Without it, today in UTC, which can be a day off."
     }
    },
    "additionalProperties": false,
    "required": [
     "tracker",
     "stars"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
     "public": true
    },
    "APP_CONFLICT": {
     "status": 409,
     "public": true
    }
   }
  },
  "trackers.delete": {
   "handler": "trackersDelete",
   "auth": "user",
   "risk": "destructive",
   "summary": "Delete a tracker",
   "description": "Deletes one of the person’s trackers and all its ratings, on every device. It can’t be undone.",
   "input": {
    "type": "object",
    "properties": {
     "tracker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The tracker’s id from trackers_list, or its exact title."
     }
    },
    "additionalProperties": false,
    "required": [
     "tracker"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
     "public": true
    },
    "APP_CONFLICT": {
     "status": 409,
     "public": true
    }
   }
  }
 }
}
