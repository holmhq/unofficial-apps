  "deck.save": {
   "handler": "opDeckSave",
   "auth": "user",
   "risk": "write",
   "summary": "Replace a deck's content with a new revision",
   "description": "Saves the whole deck as a new revision and shows it at once to anyone with the deck open. base is the version you read (deck_get); if someone changed the deck since, you get 409 and must read it again. Errors in content are refused (422) with the list; warnings come back for you to consider. For small changes prefer slides_edit.",
   "input": {
    "type": "object",
    "properties": {
     "deck": {
      "type": "string",
      "pattern": "^[a-z0-9]{12}$",
      "description": "A deck id from decks_list."
     },
     "base": {
      "type": "integer",
      "minimum": 1
     },
     "content": {
      "type": "object",
      "description": "The whole deck: {title, description, brand, accent, lang, slides:[…]}. guide_get describes every layout."
     },
     "message": {
      "type": "string",
      "maxLength": 200,
      "description": "One line for the history: what changed and why."
     }
    },
    "additionalProperties": false,
    "required": [
     "deck",
     "base",
     "content"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
     "public": true
    },
    "APP_CONFLICT": {
     "status": 409,
     "public": true
    },
    "APP_INVALID": {
     "status": 422,
     "public": true
    },
    "APP_RATE_LIMITED": {
     "status": 429,
     "public": true
    }
   },
   "sensitive": true,
   "idempotency": "optional"
  },
  "slides.edit": {
   "handler": "opSlidesEdit",
   "auth": "user",
   "risk": "write",
   "summary": "Change a few slides without resending the deck",
   "description": "Applies edits in order and saves one revision. Slides are numbered from 1 (as in the deck's #n links). ops: insert {at?, slide} (before slide at; omit at to append), replace {at, slide}, update {at, set} (merge fields into a slide; null removes a field), move {at, to}, delete {at}, deck {set} (title, description, brand, accent, lang). base is the version from deck_get.",
   "input": {
    "type": "object",
    "properties": {
     "deck": {
      "type": "string",
      "pattern": "^[a-z0-9]{12}$",
      "description": "A deck id from decks_list."
     },
     "base": {
      "type": "integer",
      "minimum": 1
     },
     "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
       "type": "object",
       "properties": {
        "op": {
         "type": "string",
         "enum": [
          "insert",
          "replace",
          "update",
          "move",
          "delete",
          "deck"
         ]
        },
        "at": {
         "type": "integer",
         "minimum": 1
        },
        "to": {
         "type": "integer",
         "minimum": 1
        },
        "slide": {
         "type": "object"
        },
        "set": {
         "type": "object"
        }
       },
       "required": [
        "op"
       ],
       "additionalProperties": false
      }
     },
     "message": {
      "type": "string",
      "maxLength": 200
     }
    },
    "additionalProperties": false,
    "required": [
     "deck",
     "base",
     "edits"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
    "APP_INVALID_INPUT": {
     "status": 400,
     "public": true
    },
    "APP_CONFLICT": {
     "status": 409,
     "public": true
    },
    "APP_INVALID": {
     "status": 422,
     "public": true
    },
    "APP_RATE_LIMITED": {
     "status": 429,
     "public": true
    }
   },
   "sensitive": true,
   "idempotency": "optional"
  },
