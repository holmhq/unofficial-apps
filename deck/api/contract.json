  "deck.get": {
   "handler": "opDeckGet",
   "auth": "user",
   "risk": "read",
   "summary": "Read a deck: its slides, notes and check",
   "description": "Returns the deck, its content (the whole deck JSON) at the latest revision or the one you name, an outline (one line per slide), the check (errors and warnings), and base: the version to pass to deck_save or slides_edit.",
   "input": {
    "type": "object",
    "properties": {
     "deck": {
      "type": "string",
      "pattern": "^[a-z0-9]{12}$",
      "description": "A deck id from decks_list."
     },
     "revision": {
      "type": "integer",
      "minimum": 1
     }
    },
    "additionalProperties": false,
    "required": [
     "deck"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
