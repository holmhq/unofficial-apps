  "decks.create": {
   "handler": "opDecksCreate",
   "auth": "user",
   "risk": "write",
   "summary": "Make a new deck in a workspace",
   "description": "Creates a deck and returns it with its url (open it to watch your saves arrive) and the base to pass to the next save. content is the whole deck (see guide_get); without it you get a cover slide titled title. Content with errors is refused (422) with the list.",
   "input": {
    "type": "object",
    "properties": {
     "workspace": {
      "type": "string",
      "pattern": "^[a-z0-9]{10}$",
      "description": "A workspace id from me_get."
     },
     "title": {
      "type": "string",
      "maxLength": 120
     },
     "content": {
      "type": "object",
      "description": "The whole deck: {title, description, brand, accent, lang, slides:[…]}. guide_get describes every layout."
     },
     "message": {
      "type": "string",
      "maxLength": 200,
      "description": "One line for the history, e.g. 'First draft from the brief'."
     }
    },
    "additionalProperties": false,
    "required": [
     "workspace"
    ]
   },
   "output": {
    "type": "object"
   },
   "errors": {
    "APP_UNAUTHORIZED": {
     "status": 401,
     "public": true
    },
    "APP_FORBIDDEN": {
     "status": 403,
     "public": true
    },
    "APP_NOT_FOUND": {
     "status": 404,
     "public": true
    },
